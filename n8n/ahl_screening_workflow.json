    {
      "id": "ahl-11",
      "name": "Check suggestions (rules, no AI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://helper:8000/assess",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $('Read PDFs (local, no AI)').first().json.run_id, assessment: $json.choices?.[0]?.message?.content ?? null, model: ($json.model ?? 'no answer') + ($('Backup scores: OpenAI').isExecuted ? ' (backup)' : '') }) }}",
        "options": {
          "timeout": 240000
        }
      },
      "executeOnce": true,
      "onError": "continueErrorOutput"
    },
    {
      "id": "ahl-12",
      "name": "Build review page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2460,
        300
      ],
      "parameters": {
        "jsCode": "// Turns the findings into a form a person can read and change.\nconst r = $input.first().json, c = $('Check answers (rules, no AI)').first().json.counts;\nconst safe = t => String(t ?? '').replace(/[&<>]/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[m]));\nconst high = r.exceptions.filter(e => e[1] === 'High'), rest = r.exceptions.length - high.length;\nconst rows = high.map(e => `<tr><td><b>${e[0]}</b></td><td><b>${safe(e[2])}</b><br>${safe(e[3])}</td></tr>`).join('');\nconst opts = list => ({ values: list.map(option => ({ option })) });\nconst choices = { B4: ['None','Low','Medium','High'], B9: ['Yes','No','Maybe'], B10: ['Yes, Adaptation','Yes, Mitigation','Maybe','No'], B11: ['Yes','No','Maybe'], B13: ['Yes','No','Maybe'], B15: ['Yes','No','Maybe'] };\nconst ask = (x, hint) => x.cell[0] === 'D' ? { fieldLabel: `${x.cell} ${x.label}: ${hint}`, fieldType: 'dropdown', fieldOptions: opts(['1','2','3','Leave blank']), requiredField: false }\n  : choices[x.cell] ? { fieldLabel: `${x.cell} ${x.label}: ${hint}`, fieldType: 'dropdown', fieldOptions: opts([...choices[x.cell], 'Leave blank']), requiredField: false }\n  : x.cell === 'B2' ? { fieldLabel: `${x.cell} ${x.label}: ${hint}`, fieldType: 'text', requiredField: false } : null;\nconst form = [\n  { fieldType: 'html', elementName: 'summary', html: `<p><b>${c.accepted}</b> memo answers verified, <b>${c.blank}</b> not stated, <b>${c.blocked}</b> blocked, <b>${c.review}</b> need a person.</p><h3>${high.length} high-severity issues</h3><table>${rows}</table><p>${rest} more issues are listed in the Exceptions tab of the workbook.</p><h3>Suggestions</h3><p>Leave a field untouched to accept the suggestion.</p>` },\n  ...r.review.map(x => ask(x, `suggested ${x.suggested}. ${x.why.replace(/^Suggested\\. /, '')}`)),\n  ...r.blank.map(x => ask(x, 'no information found')),\n  { fieldLabel: 'Your name', fieldType: 'text', requiredField: true },\n  { fieldLabel: 'Decision', fieldType: 'dropdown', fieldOptions: opts(['Approve','Reject']), requiredField: true },\n].filter(Boolean);\nreturn [{ json: { form } }];"
      }
    },
    {
      "id": "ahl-13",
      "name": "Review and approve (n8n form)",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [
        2700,
        300
      ],
      "parameters": {
        "operation": "page",
        "defineForm": "json",
        "jsonOutput": "={{ JSON.stringify($json.form) }}",
        "options": {
          "formTitle": "Review before release",
          "formDescription": "Nothing is released until you decide.",
          "buttonLabel": "Submit decision"
        }
      },
      "webhookId": "ahl-screening-13"
    },
    {
      "id": "ahl-14",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2940,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c",
              "leftValue": "={{ $json.Decision }}",
              "rightValue": "Approve",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ahl-15",
      "name": "Record decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3180,
        200
      ],
      "parameters": {
        "jsCode": "// Keeps only the fields the reviewer changed.\nconst approvals = {};\nfor (const [label, v] of Object.entries($input.first().json)) {\n  const cell = (label.match(/^([BD]\\d+) /) || [])[1];\n  if (cell && v) approvals[cell] = v === 'Leave blank' ? null : cell[0] === 'D' ? Number(v) : v;\n}\nreturn [{ json: { run_id: $('Read PDFs (local, no AI)').first().json.run_id, approvals, reviewer: $input.first().json['Your name'] } }];"
      }
    },
    {
      "id": "ahl-16",
      "name": "Fill Excel and verify (no AI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3420,
        200
