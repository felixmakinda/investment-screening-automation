        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('AI models used').first().json.backup_model, store: false, ...$('Read PDFs (local, no AI)').first().json.ai_request }) }}",
        "options": {
