        }
      },
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAi account"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "id": "ahl-07",
      "name": "Check answers (rules, no AI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://helper:8000/validate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $('Read PDFs (local, no AI)').first().json.run_id, reader_a: $json.choices?.[0]?.message?.content ?? null, model_a: ($json.model ?? 'no answer') + ($('Backup reader: OpenAI').isExecuted ? ' (backup)' : '') }) }}",
        "options": {
          "timeout": 240000
        }
      },
      "executeOnce": true,
      "onError": "continueErrorOutput"
