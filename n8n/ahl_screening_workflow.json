      "typeVersion": 2.3,
      "position": [
        3920,
        200
      ],
      "parameters": {
        "operation": "completion",
        "respondWith": "returnBinary",
        "completionTitle": "Screening complete",
        "completionMessage": "={{ $('Fill Excel and verify (no AI)').first().json.status }}. Score {{ ($('Fill Excel and verify (no AI)').first().json.results.score * 100).toFixed(1) }}%, cautious case {{ ($('Fill Excel and verify (no AI)').first().json.cautious_score * 100).toFixed(1) }}%. {{ $('Fill Excel and verify (no AI)').first().json.exceptions }} issues to follow up.",
        "inputDataFieldName": "data",
        "options": {}
      },
      "webhookId": "ahl-screening-18"
    },
    {
      "id": "ahl-19",
      "name": "Rejected",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [
