{
  "id": "ahlScreening0001",
  "name": "AHL deal screening",
  "nodes": [
    {
      "id": "ahl-01",
      "name": "Upload PDFs (n8n form)",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.3,
      "position": [
        0,
        300
      ],
      "parameters": {
        "formTitle": "AHL deal screening",
        "formDescription": "Upload the investment memo and the audited accounts. You will review the findings before anything is released.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Investment memo (PDF)",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".pdf",
              "requiredField": true
            },
            {
              "fieldLabel": "Audited accounts (PDF)",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".pdf",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Start screening"
        }
      },
      "webhookId": "ahl-screening-01"
    },
    {
      "id": "ahl-02",
      "name": "Read PDFs (local, no AI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://helper:8000/read",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "options": {
          "timeout": 120000
        },
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "memo",
              "inputDataFieldName": "Investment_memo__PDF_"
            },
            {
              "parameterType": "formBinaryData",
              "name": "accounts",
              "inputDataFieldName": "Audited_accounts__PDF_"
            }
          ]
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "ahl-03",
      "name": "AI models used",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a",
              "name": "main_model",
              "value": "anthropic/claude-sonnet-5.5",
              "type": "string"
            },
            {
              "id": "b",
              "name": "backup_model",
              "value": "gpt-6-sol",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "ahl-04",
      "name": "AI reader: Claude (OpenRouter)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.main_model, provider: { sort: 'throughput', zdr: true, data_collection: 'deny', require_parameters: true }, ...$json.ai_request }) }}",
        "options": {
          "timeout": 150000
        }
      },
      "credentials": {
        "openRouterApi": {
          "id": "",
          "name": "OpenRouter account"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "id": "ahl-05",
      "name": "Reader finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c",
              "leftValue": "={{ $json.choices?.[0]?.finish_reason === 'stop' && ($json.choices[0].message.content.match(/\"value\"\\s*:\\s*\"/g) || []).length >= 40 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ahl-06",
      "name": "Backup reader: OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
